# ── JIRA Cloud ──
JIRA_BASE_URL=https://subex.atlassian.net
JIRA_EMAIL=your.email@example.com
JIRA_API_TOKEN=your-atlassian-api-token

# ── Claude AI ──
CLAUDE_API_KEY=sk-ant-xxxxx

# ── App settings ──
EXPECTED_HOURS=168
PORT=5000
FLASK_DEBUG=0

# ── GitHub Copilot metrics ──
GITHUB_TOKEN=ghp_xxxxx
# "enterprise" or "organization"
SCOPE=enterprise
GITHUB_ENT=your-enterprise-slug
GITHUB_ORG=your-org-slug
# Optional: override for GHE.com data-residency. Leave blank for github.com
GITHUB_API_BASE_URL=https://api.github.com
# Cache lifetime in seconds (Copilot metrics update ~daily, so 1h is plenty)
CACHE_TTL=3600

# ── Azure (set in App Service Configuration) ──
# WEBSITES_PORT=8000